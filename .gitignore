# User-supplied or generated inputs
original/
bin/
Sample/
output/

# The toolchain is user-supplied or downloaded, except for the one helper this
# repository authors: verify_egcs_1_1_2.py, which checks the downloaded compiler
# against its stock SHA-256 identities. setup_toolchain.sh and test_all_tu.sh
# both require it, so excluding it would leave the published scripts unable to
# run. It contains no third-party code.
toolchain/*
!toolchain/verify_egcs_1_1_2.py

# Archives and binary build products
.recovery/
*.7z
*.rar
*.zip
*.tar
*.tar.gz
*.tar.xz
*.a
*.bin
*.dll
*.elf
*.exe
*.lib
*.map
*.o
*.obj
*.sym

# Editors, assistants, worktrees, and local environment files
.claude/
.codex/
.agents/
.cursor/
.idea/
.vscode/
.worktrees/
.env
.env.*
!.env.example

# Python/test caches and local diagnostics
__pycache__/
*.py[cod]
.pytest_cache/
debug_*
match_results.txt
